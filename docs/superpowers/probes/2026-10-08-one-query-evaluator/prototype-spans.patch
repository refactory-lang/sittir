+
+/// What a condition reads: a slot by its parser routes, or the node's own text.
+#[derive(serde::Deserialize)]
+#[serde(untagged)]
+pub enum Subject {
+    Slot(Routes),
+    Own {
+        #[serde(rename = "self")]
+        _own: bool,
+    },
+}
+
+/// The byte spans of each subject's values on `node`, in subject order.
+pub fn subject_spans(node: &tree_sitter::Node<'_>, subjects: &[Subject]) -> Vec<Vec<[usize; 2]>> {
+    subjects
+        .iter()
+        .map(|subject| match subject {
+            Subject::Own { .. } => vec![[node.start_byte(), node.end_byte()]],
+            Subject::Slot(routes) => (0..node.child_count() as u32)
+                .filter_map(|i| {
+                    let child = node.child(i)?;
+                    (!child.is_extra() && routes.admits(node.field_name_for_child(i), &child)).then(|| [child.start_byte(), child.end_byte()])
+                })
+                .collect(),
+        })
+        .collect()
 }
 
