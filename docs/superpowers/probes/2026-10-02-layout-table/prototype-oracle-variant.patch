diff --git a/rust/crates/sittir-core/src/oracle.rs b/rust/crates/sittir-core/src/oracle.rs
new file mode 100644
index 000000000..0f662ce56
--- /dev/null
+++ b/rust/crates/sittir-core/src/oracle.rs
@@ -0,0 +1,290 @@
+//! PROTOTYPE (seam oracle), throwaway measurement for the width design note.
+//!
+//! With `SITTIR_SEAM_ORACLE=<dir>` set, every render keeps a copy of its
+//! output and a record of each gap it resolved (the spacing sites whose marks
+//! met there, the list role, the bracket flags). `finish` hands that record
+//! here: the output is parsed with the grammar's parser, with the parse log
+//! on, and for each gap the parse states in which the token after it was
+//! lexed are looked up, with the watched symbols valid in them
+//! (`SITTIR_SEAM_WATCH`, comma separated). One JSON line per gap is appended
+//! to `<dir>/<grammar>.jsonl`.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::io::Write as _;
+use std::rc::Rc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+pub type Configure = fn(&mut tree_sitter::Parser) -> bool;
+
+static CONFIGURE: Mutex<Option<Configure>> = Mutex::new(None);
+static SEQ: AtomicU64 = AtomicU64::new(0);
+
+pub fn wanted() -> bool {
+    static WANTED: OnceLock<bool> = OnceLock::new();
+    *WANTED.get_or_init(|| std::env::var_os("SITTIR_SEAM_ORACLE").is_some())
+}
+
+fn watch() -> &'static [String] {
+    static WATCH: OnceLock<Vec<String>> = OnceLock::new();
+    WATCH.get_or_init(|| {
+        std::env::var("SITTIR_SEAM_WATCH")
+            .unwrap_or_else(|_| "_newline,_indent,_dedent,_automatic_semicolon,_function_signature_automatic_semicolon".to_string())
+            .split(',')
+            .filter(|s| !s.is_empty())
+            .map(str::to_string)
+            .collect()
+    })
+}
+
+pub fn register(configure: Configure) {
+    if let Ok(mut slot) = CONFIGURE.lock() {
+        *slot = Some(configure);
+    }
+}
+
+#[derive(Default)]
+pub struct Probe {
+    pub text: String,
+    pub gaps: Vec<ProbeGap>,
+    pub root: bool,
+    pending_sites: Vec<u32>,
+    pending_roles: Vec<(u8, u32, bool)>,
+    pending_flags: u8,
+    lists: Vec<bool>,
+    open: Vec<u32>,
+}
+
+pub struct ProbeGap {
+    pub at: u32,
+    pub ws: String,
+    pub sites: Vec<u32>,
+    pub roles: Vec<(u8, u32, bool)>,
+    pub flags: u8,
+}
+
+pub const ROLE_HEAD: u8 = 1;
+pub const ROLE_BEFORE: u8 = 2;
+pub const ROLE_AFTER: u8 = 3;
+pub const ROLE_TAIL: u8 = 4;
+
+impl Probe {
+    pub fn site(&mut self, site: u32, flags: u8) {
+        self.pending_sites.push(site);
+        self.pending_flags |= flags;
+    }
+
+    pub fn list_open(&mut self, separated: bool) {
+        let id = self.lists.len() as u32;
+        self.lists.push(separated);
+        self.open.push(id);
+        self.pending_roles.push((ROLE_HEAD, id, separated));
+    }
+
+    pub fn list_gap(&mut self, after: bool) {
+        if let Some(&id) = self.open.last() {
+            let separated = self.lists[id as usize];
+            self.pending_roles.push((if after { ROLE_AFTER } else { ROLE_BEFORE }, id, separated));
+        }
+    }
+
+    pub fn list_close(&mut self) {
+        if let Some(id) = self.open.pop() {
+            let separated = self.lists[id as usize];
+            self.pending_roles.push((ROLE_TAIL, id, separated));
+        }
+    }
+
+    pub fn close_gap(&mut self, at: usize) {
+        if self.pending_sites.is_empty() && self.pending_roles.is_empty() {
+            self.pending_flags = 0;
+            return;
+        }
+        self.gaps.push(ProbeGap {
+            at: at as u32,
+            ws: self.text[at..].to_string(),
+            sites: std::mem::take(&mut self.pending_sites),
+            roles: std::mem::take(&mut self.pending_roles),
+            flags: std::mem::replace(&mut self.pending_flags, 0),
+        });
+    }
+}
+
+fn line_starts(text: &str) -> Vec<usize> {
+    let mut starts = vec![0];
+    for (i, b) in text.bytes().enumerate() {
+        if b == b'\n' {
+            starts.push(i + 1);
+        }
+    }
+    starts
+}
+
+fn leaves<'t>(tree: &'t tree_sitter::Tree) -> Vec<tree_sitter::Node<'t>> {
+    let mut out = Vec::new();
+    let mut cursor = tree.walk();
+    loop {
+        let node = cursor.node();
+        if node.child_count() == 0 {
+            if node.end_byte() > node.start_byte() {
+                out.push(node);
+            }
+        } else if cursor.goto_first_child() {
+            continue;
+        }
+        loop {
+            if cursor.goto_next_sibling() {
+                break;
+            }
+            if !cursor.goto_parent() {
+                return out;
+            }
+        }
+    }
+}
+
+fn chain<'t>(leaf: tree_sitter::Node<'t>) -> Vec<tree_sitter::Node<'t>> {
+    let mut out = vec![leaf];
+    let mut node = leaf;
+    while let Some(parent) = node.parent() {
+        out.push(parent);
+        node = parent;
+    }
+    out
+}
+
+fn label(node: tree_sitter::Node<'_>) -> String {
+    if node.is_named() {
+        node.kind().to_string()
+    } else {
+        format!("\"{}\"", node.kind())
+    }
+}
+
+pub fn observe(probe: Probe) {
+    let Some(dir) = std::env::var_os("SITTIR_SEAM_ORACLE") else { return };
+    let Some(configure) = CONFIGURE.lock().ok().and_then(|slot| *slot) else { return };
+    let mut parser = tree_sitter::Parser::new();
+    if !configure(&mut parser) {
+        return;
+    }
+    let Some(language) = parser.language().map(|language| (*language).clone()) else { return };
+    let grammar = language.name().unwrap_or("grammar").to_string();
+    let starts = line_starts(&probe.text);
+    let states: Rc<RefCell<HashMap<usize, Vec<u16>>>> = Rc::new(RefCell::new(HashMap::new()));
+    {
+        let states = Rc::clone(&states);
+        let starts = starts.clone();
+        parser.set_logger(Some(Box::new(move |kind, message: &str| {
+            if kind != tree_sitter::LogType::Parse {
+                return;
+            }
+            let Some(rest) = message.strip_prefix("process version:") else { return };
+            let field = |name: &str| -> Option<usize> {
+                let i = rest.find(name)? + name.len();
+                rest[i..].split(|c: char| !c.is_ascii_digit()).next()?.parse().ok()
+            };
+            let (Some(state), Some(row), Some(col)) = (field("state:"), field("row:"), field("col:")) else { return };
+            let Some(&line) = starts.get(row) else { return };
+            states.borrow_mut().entry(line + col).or_default().push(state as u16);
+        })));
+    }
+    let Some(tree) = parser.parse(&probe.text, None) else { return };
+    parser.set_logger(None);
+    let states = states.borrow();
+    let root = tree.root_node();
+    let err = root.has_error();
+    let leaves = leaves(&tree);
+    // Lexical bracket depth after each leaf: anonymous bracket tokens only.
+    let mut depth_after: Vec<i32> = Vec::with_capacity(leaves.len());
+    let mut depth = 0i32;
+    for leaf in &leaves {
+        if !leaf.is_named() {
+            match leaf.kind() {
+                "(" | "[" | "{" => depth += 1,
+                ")" | "]" | "}" => depth -= 1,
+                _ => {}
+            }
+        }
+        depth_after.push(depth);
+    }
+    let seq = SEQ.fetch_add(1, Ordering::Relaxed);
+    let mut valid_cache: HashMap<u16, Vec<String>> = HashMap::new();
+    let mut valid_in = |state: u16| -> Vec<String> {
+        valid_cache
+            .entry(state)
+            .or_insert_with(|| {
+                let mut names = Vec::new();
+                if let Some(mut it) = language.lookahead_iterator(state) {
+                    for name in it.iter_names() {
+                        if watch().iter().any(|w| w == name) && !names.iter().any(|n: &String| n == name) {
+                            names.push(name.to_string());
+                        }
+                    }
+                }
+                names
+            })
+            .clone()
+    };
+    let mut lines = String::new();
+    for gap in &probe.gaps {
+        let at = gap.at as usize;
+        let here: Vec<u16> = states.get(&at).cloned().unwrap_or_default();
+        let mut any: Vec<String> = Vec::new();
+        for &s in &here {
+            for name in valid_in(s) {
+                if !any.contains(&name) {
+                    any.push(name);
+                }
+            }
+        }
+        let first = here.first().map(|&s| valid_in(s)).unwrap_or_default();
+        let prev_index = leaves.partition_point(|leaf| leaf.end_byte() <= at).checked_sub(1);
+        let prev = prev_index.map(|i| leaves[i]);
+        let lexical_depth = prev_index.map(|i| depth_after[i]).unwrap_or(0);
+        let next_index = leaves.partition_point(|leaf| leaf.start_byte() < at);
+        let next = leaves.get(next_index).copied();
+        let (mut lca, mut left, mut right) = (String::new(), String::new(), String::new());
+        let (mut ends, mut begins) = (Vec::new(), Vec::new());
+        if let (Some(prev), Some(next)) = (prev, next) {
+            let up = chain(prev);
+            let down = chain(next);
+            if let Some(j) = down.iter().position(|n| n.start_byte() <= prev.start_byte() && n.end_byte() >= prev.end_byte()) {
+                let common = down[j];
+                lca = label(common);
+                let below_left: Vec<_> = up.iter().take_while(|n| n.id() != common.id()).copied().collect();
+                let below_right: Vec<_> = down[..j].to_vec();
+                left = below_left.last().map(|n| label(*n)).unwrap_or_default();
+                right = below_right.last().map(|n| label(*n)).unwrap_or_default();
+                ends = below_left.iter().map(|n| label(*n)).collect();
+                begins = below_right.iter().map(|n| label(*n)).collect();
+            }
+        }
+        let line = serde_json::json!({
+            "r": seq,
+            "root": probe.root,
+            "err": err,
+            "at": gap.at,
+            "ws": gap.ws,
+            "sites": gap.sites,
+            "roles": gap.roles,
+            "flags": gap.flags,
+            "depth": lexical_depth,
+            "states": here,
+            "any": any,
+            "first": first,
+            "lca": lca,
+            "left": left,
+            "right": right,
+            "ends": ends,
+            "begins": begins,
