+            let mut start = 0usize;
+            for (i, row) in self.rows.iter().enumerate() {
+                let bytes = &self.text[start..row.end as usize];
+                start = row.end as usize;
+                let kind = if row.kind & LEXICAL != 0 { "lexical" } else if row.kind & SEAM != 0 { "seam" } else { "text" };
+                let role = ["", "head", "before", "after", "tail"][(row.fact & ROLE_MASK) as usize];
+                let list = if row.list == NO_LIST { String::new() } else { format!("L{}", row.list) };
+                let why = row.fact >> 3;
+                let adjustable = if row.kind & SEAM == 0 { "" } else if self.adjustable(i) { "yes" } else if row.list == NO_LIST { "no: not a list gap" } else if why & WHY_SET != 0 { "no: set" } else if why & WHY_SOURCE != 0 { "no: from source" } else if why & (WHY_FIXED | WHY_ROOT) != 0 { "no: fixed" } else if row.kind & HAS_NEWLINE != 0 { "no: already a line break" } else if row.fact & ROLE_MASK == ROLE_BEFORE { "no: before a separator" } else { "no: its list is not bracketed and separated" };
+                eprintln!("DUMP {i:>3} | {kind:<7} | {bytes:<12?} | {:>5} | {list:<3} | {role:<6} | {adjustable:<40} | {}{}{}", row.depth, if row.kind & STARTS_LINE != 0 { "starts-line " } else { "" }, if row.kind & CONDITIONAL != 0 { "conditional " } else { "" }, if row.kind & BREAK != 0 { "BROKEN" } else { "" });
