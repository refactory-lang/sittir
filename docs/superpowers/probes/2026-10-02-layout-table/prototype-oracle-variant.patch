+            for (l, list) in self.lists.iter().enumerate() {
+                eprintln!("DUMPL L{l} parent={} head={} tail={} separated={} opens_at_bracket={} closes_at_bracket={} broken={}", if list.parent == NO_LIST { "-".to_string() } else { format!("L{}", list.parent) }, list.head, list.tail, list.flags & LIST_SEPARATED != 0, list.flags & LIST_OPENS_AT_BRACKET != 0, list.flags & LIST_CLOSES_AT_BRACKET != 0, list.flags & LIST_BROKEN != 0);
+            }
+        }
+        if std::env::var_os("SITTIR_LAYOUT_ROWS").is_some() {
+            let mut start = 0u32;
+            let (mut text, mut seam_list, mut seam_empty, mut seam_space, mut seam_break, mut lexical, mut adjustable, mut broken) = (0, 0, 0, 0, 0, 0, 0, 0);
+            for (i, row) in self.rows.iter().enumerate() {
+                let len = row.end - start;
+                start = row.end;
+                if row.kind & SEAM == 0 {
+                    text += 1;
+                    continue;
+                }
+                if row.kind & LEXICAL != 0 {
+                    lexical += 1;
+                } else if row.fact & ROLE_MASK != ROLE_NONE {
+                    seam_list += 1;
+                } else if len == 0 {
+                    seam_empty += 1;
+                } else if row.kind & HAS_NEWLINE != 0 {
+                    seam_break += 1;
+                } else {
+                    seam_space += 1;
+                }
+                if self.adjustable(i) {
+                    adjustable += 1;
+                }
+                if row.kind & BREAK != 0 {
+                    broken += 1;
+                }
+            }
+            eprintln!("ROWS text={text} list_seams={seam_list} other_empty={seam_empty} other_space={seam_space} other_break={seam_break} lexical={lexical} adjustable={adjustable} broken_seams={broken}");
+        }
+        Ok(LayoutStats {
+            text_bytes: self.text.len(),
+            rows: self.rows.len(),
+            seam_rows: self.rows.iter().filter(|r| r.kind & SEAM != 0).count(),
+            lists: self.lists.len(),
+            breakable_lists: self.lists.iter().filter(|l| l.flags & need == need).count(),
+            broken_lists: self.lists.iter().filter(|l| l.flags & LIST_BROKEN != 0).count(),
+            table_bytes: self.text.capacity() + self.rows.capacity() * std::mem::size_of::<Row>() + self.lists.capacity() * std::mem::size_of::<List>(),
+            out_bytes: written,
+        })
+    }
+}
