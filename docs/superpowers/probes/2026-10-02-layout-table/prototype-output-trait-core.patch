+//! PROTOTYPE (throwaway, for measurements): a transient layout table filled by
+//! `SpacingWriter` during one render, adjusted by a breaking rule, and
+//! flattened to text.
+
+use std::fmt;
+
+pub const NO_LIST: u32 = u32::MAX;
+pub const NO_ROW: u32 = u32::MAX;
+
+/// Row kinds and marks.
+pub const SEAM: u8 = 1;
+/// The writer owed indentation before this row (it starts a line).
+pub const STARTS_LINE: u8 = 2;
+/// Written only when its list is broken (a conditional trailing separator).
+pub const CONDITIONAL: u8 = 4;
+/// Set by the pass: this seam is a line break.
+pub const BREAK: u8 = 8;
+/// The row's flat bytes contain a line break.
+pub const HAS_NEWLINE: u8 = 16;
+/// A space the writer put between two word characters.
+pub const LEXICAL: u8 = 32;
+
+/// A seam's place in its list (`fact & ROLE_MASK`).
+pub const ROLE_MASK: u8 = 7;
+pub const ROLE_NONE: u8 = 0;
+pub const ROLE_HEAD: u8 = 1;
+pub const ROLE_BEFORE: u8 = 2;
+pub const ROLE_AFTER: u8 = 3;
+pub const ROLE_TAIL: u8 = 4;
+
+/// Why a seam is not adjustable (`fact >> 3`), as bits; 0 means nothing at the
+/// gap itself forbids it.
+pub const WHY_SET: u8 = 1;
+pub const WHY_SOURCE: u8 = 2;
+pub const WHY_FIXED: u8 = 4;
+pub const WHY_ROOT: u8 = 8;
+
+/// Site flags (`ResolvedOptions::site_flags`).
+pub const SITE_AFTER_OPEN_BRACKET: u8 = 1;
+pub const SITE_BEFORE_CLOSE_BRACKET: u8 = 2;
+
+/// List flags.
+pub const LIST_SEPARATED: u8 = 1;
+pub const LIST_OPENS_AT_BRACKET: u8 = 2;
+pub const LIST_CLOSES_AT_BRACKET: u8 = 4;
+pub const LIST_HOLDS_BREAK: u8 = 8;
+pub const LIST_BROKEN: u8 = 16;
+pub const LIST_SHIFTED: u8 = 32;
+
+#[derive(Clone, Copy, Debug)]
+pub struct Row {
+    /// One past this row's bytes in `text`; it starts where the previous row ends.
+    pub end: u32,
+    /// Seam: the list whose gap this is. Conditional text: the list it waits on.
+    pub list: u32,
+    /// The writer's depth when the row was written.
+    pub depth: u16,
+    pub kind: u8,
+    /// Seam: role in its list and why it is not adjustable.
+    pub fact: u8,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct List {
+    pub parent: u32,
+    pub head: u32,
+    pub tail: u32,
+    pub flags: u8,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Breaking {
+    Group,
+    Fill,
+}
+
+#[derive(Clone, Default)]
+pub struct GapNote {
+    list: u32,
+    role: u8,
+    why: u8,
+    brackets: u8,
+    heads: Vec<u32>,
+    tails: Vec<u32>,
+}
+
+pub struct Layout {
+    pub text: String,
+    pub rows: Vec<Row>,
+    pub lists: Vec<List>,
+    open: Vec<u32>,
+    gap: GapNote,
+    line_start: bool,
+    in_seam: bool,
+    conditional: u32,
+    pub limit: u32,
+    pub rule: Breaking,
+    pub tab: u32,
+}
+
+#[derive(Debug, Default, Clone, Copy)]
+pub struct LayoutStats {
+    pub text_bytes: usize,
+    pub rows: usize,
+    pub seam_rows: usize,
+    pub lists: usize,
+    pub breakable_lists: usize,
+    pub broken_lists: usize,
+    pub table_bytes: usize,
+    pub out_bytes: usize,
+}
+
+impl Layout {
+    pub fn new(limit: u32, rule: Breaking, tab: u32) -> Self {
+        Self {
+            text: String::new(),
+            rows: Vec::new(),
+            lists: Vec::new(),
+            open: Vec::new(),
+            gap: GapNote { list: NO_LIST, ..GapNote::default() },
+            line_start: false,
+            in_seam: false,
+            conditional: NO_LIST,
+            limit,
+            rule,
+            tab,
+        }
+    }
+
+    /// Bytes from the writer's `emit`: a piece of text, or the bytes of the
+    /// seam being flushed.
+    pub fn bytes(&mut self, s: &str, depth: usize) {
+        self.text.push_str(s);
+        if self.in_seam {
+            return;
+        }
+        let end = self.text.len() as u32;
+        let newline = if s.contains('\n') { HAS_NEWLINE } else { 0 };
+        let merge = !self.line_start && self.conditional == NO_LIST;
+        match self.rows.last_mut() {
+            Some(last) if merge && last.kind & (SEAM | CONDITIONAL) == 0 => {
+                last.end = end;
+                last.kind |= newline;
+            }
+            _ => {
+                let starts = if std::mem::take(&mut self.line_start) { STARTS_LINE } else { 0 };
+                let conditional = if self.conditional == NO_LIST { 0 } else { CONDITIONAL };
+                self.rows.push(Row { end, list: self.conditional, depth: depth as u16, kind: starts | conditional | newline, fact: 0 });
+            }
+        }
+    }
+
+    pub fn lexical_space(&mut self, depth: usize) {
+        self.text.push(' ');
+        let conditional = if self.conditional == NO_LIST { 0 } else { CONDITIONAL };
+        self.rows.push(Row { end: self.text.len() as u32, list: self.conditional, depth: depth as u16, kind: SEAM | LEXICAL | conditional, fact: 0 });
+    }
+
+    pub fn owe_indent(&mut self) {
+        self.line_start = true;
+    }
+
+    pub fn seam_begin(&mut self) -> usize {
+        self.in_seam = true;
+        self.text.len()
+    }
+
+    /// The gap's seam was flushed (`marked`), or there was none: record its
+    /// row when it holds a mark or a list role.
+    pub fn seam_end(&mut self, start: usize, marked: bool, depth: usize) {
+        self.in_seam = false;
+        let gap = std::mem::replace(&mut self.gap, GapNote { list: NO_LIST, ..GapNote::default() });
+        if !marked && gap.role == ROLE_NONE && gap.heads.is_empty() && gap.tails.is_empty() {
+            return;
+        }
+        let end = self.text.len() as u32;
+        let newline = if self.text[start..].contains('\n') { HAS_NEWLINE } else { 0 };
+        let starts = if std::mem::take(&mut self.line_start) { STARTS_LINE } else { 0 };
+        let conditional = if self.conditional == NO_LIST { 0 } else { CONDITIONAL };
+        let index = self.rows.len() as u32;
+        let (list, role) = if self.conditional != NO_LIST { (self.conditional, ROLE_BEFORE) } else { (gap.list, gap.role) };
+        self.rows.push(Row { end, list, depth: depth as u16, kind: SEAM | starts | conditional | newline, fact: role | (gap.why << 3) });
+        for &l in &gap.heads {
+            let entry = &mut self.lists[l as usize];
+            entry.head = index;
+            if gap.brackets & SITE_AFTER_OPEN_BRACKET != 0 {
+                entry.flags |= LIST_OPENS_AT_BRACKET;
+            }
+        }
+        for &l in &gap.tails {
+            let entry = &mut self.lists[l as usize];
+            entry.tail = index;
+            if gap.brackets & SITE_BEFORE_CLOSE_BRACKET != 0 {
+                entry.flags |= LIST_CLOSES_AT_BRACKET;
+            }
+        }
+        if newline != 0 && list != NO_LIST && (role == ROLE_BEFORE || role == ROLE_AFTER) && conditional == 0 {
+            self.lists[list as usize].flags |= LIST_HOLDS_BREAK;
+        }
+    }
+
+    pub fn note(&mut self, why: u8) {
+        self.gap.why |= why;
+    }
+
+    pub fn note_site(&mut self, flags: u8, set: bool) {
+        self.gap.brackets |= flags;
+        if set {
+            self.gap.why |= WHY_SET;
+        }
+    }
+
+    pub fn list_open(&mut self, separated: bool) {
+        let index = self.lists.len() as u32;
+        let parent = self.open.last().copied().unwrap_or(NO_LIST);
+        self.lists.push(List { parent, head: NO_ROW, tail: NO_ROW, flags: if separated { LIST_SEPARATED } else { 0 } });
+        self.open.push(index);
+        self.gap.heads.push(index);
+        if self.gap.role == ROLE_NONE {
+            self.gap.role = ROLE_HEAD;
+            self.gap.list = index;
+        }
+    }
+
+    pub fn list_gap(&mut self, role: u8) {
+        if let Some(&list) = self.open.last() {
+            self.gap.role = role;
+            self.gap.list = list;
+        }
+    }
+
+    pub fn list_close(&mut self) {
+        if let Some(list) = self.open.pop() {
+            self.gap.tails.push(list);
+            self.gap.role = ROLE_TAIL;
+            self.gap.list = list;
+        }
+    }
+
+    pub fn current_list(&self) -> u32 {
+        self.open.last().copied().unwrap_or(NO_LIST)
+    }
+
+    pub fn take_gap(&mut self) -> GapNote {
+        std::mem::replace(&mut self.gap, GapNote { list: NO_LIST, ..GapNote::default() })
+    }
+
+    pub fn put_gap(&mut self, gap: GapNote) {
+        self.gap = gap;
+    }
+
+    pub fn set_conditional(&mut self, list: u32) {
+        self.conditional = list;
+    }
+
+    fn start_of(&self, row: usize) -> usize {
+        if row == 0 { 0 } else { self.rows[row - 1].end as usize }
+    }
+
+    fn bytes_of(&self, row: usize) -> &str {
+        &self.text[self.start_of(row)..self.rows[row].end as usize]
+    }
+
+    fn columns(&self, s: &str) -> u32 {
+        if s.is_ascii() {
+            let tabs = s.bytes().filter(|&b| b == b'\t').count() as u32;
+            s.len() as u32 + tabs * (self.tab.saturating_sub(1))
+        } else {
+            s.chars().map(|c| if c == '\t' { self.tab } else { 1 }).sum()
+        }
+    }
+
+    /// Whether nothing at the row itself, or at its list, forbids turning it
+    /// into a line break.
+    pub fn adjustable(&self, row: usize) -> bool {
+        let r = &self.rows[row];
+        if r.kind & SEAM == 0 || r.kind & (HAS_NEWLINE | CONDITIONAL | LEXICAL) != 0 || r.list == NO_LIST {
+            return false;
+        }
+        let role = r.fact & ROLE_MASK;
+        if !(role == ROLE_HEAD || role == ROLE_AFTER || role == ROLE_TAIL) || r.fact >> 3 != 0 {
+            return false;
+        }
+        let need = LIST_SEPARATED | LIST_OPENS_AT_BRACKET | LIST_CLOSES_AT_BRACKET;
+        self.lists[r.list as usize].flags & need == need
+    }
+
+    /// A list the pass may break as a whole: bracketed, separated, and each
+    /// flank either adjustable or already a line break.
+    fn breakable(&self, list: usize) -> bool {
+        let l = &self.lists[list];
+        let need = LIST_SEPARATED | LIST_OPENS_AT_BRACKET | LIST_CLOSES_AT_BRACKET;
+        if l.flags & need != need || l.head == NO_ROW || l.tail == NO_ROW {
+            return false;
+        }
+        let flank = |row: u32| self.adjustable(row as usize) || self.rows[row as usize].kind & HAS_NEWLINE != 0;
+        flank(l.head) && flank(l.tail)
+    }
+
+    fn indent_width(&self, depth: u32, indent: &str) -> u32 {
+        depth * self.columns(indent)
+    }
+
+    /// Group breaking: a list stays on its line when it and what follows it,
+    /// up to the next place the line can end, fit; otherwise every adjustable
+    /// seam of the list becomes a line break.
+    fn lay_out_group(&mut self, indent: &str) {
+        self.mark_broken_as_written();
+        let mut col: u32 = 0;
+        let mut shift: u32 = 0;
+        let mut owed = false;
+        for i in 0..self.rows.len() {
+            let row = self.rows[i];
+            if row.kind & CONDITIONAL != 0 && self.lists[row.list as usize].flags & LIST_BROKEN == 0 {
+                continue;
+            }
+            if row.kind & SEAM != 0 && row.kind & CONDITIONAL == 0 && row.list != NO_LIST {
+                let l = row.list as usize;
+                if self.lists[l].head == i as u32 && self.lists[l].flags & LIST_BROKEN == 0 && self.breakable(l) && !self.fits(i, col) {
+                    self.lists[l].flags |= LIST_BROKEN;
+                }
+                if self.lists[l].flags & LIST_BROKEN != 0 && self.breakable(l) && self.adjustable(i) {
+                    self.rows[i].kind |= BREAK;
+                    let role = row.fact & ROLE_MASK;
+                    if role == ROLE_HEAD {
+                        self.lists[l].flags |= LIST_SHIFTED;
+                        shift += 1;
+                    }
+                    if role == ROLE_TAIL && self.lists[l].flags & LIST_SHIFTED != 0 {
+                        shift -= 1;
+                    }
+                    col = 0;
+                    owed = true;
+                    continue;
+                }
+                if row.fact & ROLE_MASK == ROLE_TAIL && self.lists[l].flags & LIST_SHIFTED != 0 {
+                    shift -= 1;
+                }
+            }
+            let starts = row.kind & STARTS_LINE != 0 || (owed && row.kind & LEXICAL == 0);
+            if owed && row.kind & LEXICAL != 0 {
+                continue;
+            }
+            if starts {
+                col = self.indent_width(row.depth as u32 + shift, indent);
+                owed = false;
+            }
+            let bytes = self.bytes_of(i);
+            if row.kind & HAS_NEWLINE != 0 {
+                col = self.columns(&bytes[bytes.rfind('\n').map_or(0, |at| at + 1)..]);
+            } else {
+                col += self.columns(bytes);
+            }
+        }
+    }
+
+    /// A list is broken as written when a gap between its items holds a line
+    /// break, or when a flank that sits at its bracket does.
+    fn mark_broken_as_written(&mut self) {
+        for l in 0..self.lists.len() {
+            let list = self.lists[l];
+            let flank = |row: u32, at_bracket: u8| row != NO_ROW && list.flags & at_bracket != 0 && self.rows[row as usize].kind & HAS_NEWLINE != 0;
+            if list.flags & LIST_HOLDS_BREAK != 0 || flank(list.head, LIST_OPENS_AT_BRACKET) || flank(list.tail, LIST_CLOSES_AT_BRACKET) {
+                self.lists[l].flags |= LIST_BROKEN;
+            }
+        }
+    }
+
+    /// Whether the list whose head gap is row `head` fits on the line that
+    /// stands at `col`: its rows flat, then what follows it up to the next
+    /// place the line can end. A line break inside the list ends the
+    /// measurement there.
+    fn fits(&self, head: usize, col: u32) -> bool {
+        let list = self.rows[head].list;
+        let tail = self.lists[list as usize].tail as usize;
+        let mut used = col;
+        let mut i = head;
+        while i < self.rows.len() {
+            let row = &self.rows[i];
+            if row.kind & CONDITIONAL != 0 {
+                i += 1;
+                continue;
+            }
+            if i > tail && row.kind & SEAM != 0 && row.list != NO_LIST {
+                let l = row.list as usize;
+                let opens = self.lists[l].head == i as u32 && self.breakable(l);
+                let ends = self.lists[l].flags & LIST_BROKEN != 0 && self.adjustable(i);
+                if opens || ends {
+                    return used <= self.limit;
+                }
+            }
+            let bytes = self.bytes_of(i);
+            if row.kind & HAS_NEWLINE != 0 {
+                used += self.columns(&bytes[..bytes.find('\n').unwrap_or(bytes.len())]);
+                return used <= self.limit;
+            }
+            used += self.columns(bytes);
+            if used > self.limit {
+                return false;
+            }
+            i += 1;
+        }
+        used <= self.limit
+    }
+
+    /// Fill breaking: a separator gap becomes a line break only when the item
+    /// after it would cross the limit.
+    fn lay_out_fill(&mut self, indent: &str) {
+        self.mark_broken_as_written();
+        let mut col: u32 = 0;
+        let mut shift: u32 = 0;
+        let mut owed = false;
+        for i in 0..self.rows.len() {
+            let row = self.rows[i];
+            if row.kind & CONDITIONAL != 0 {
+                continue;
+            }
+            if row.kind & SEAM != 0 && row.list != NO_LIST {
+                let l = row.list as usize;
+                let role = row.fact & ROLE_MASK;
+                if role == ROLE_AFTER && self.adjustable(i) && !self.item_fits(i, col) {
+                    self.rows[i].kind |= BREAK;
+                    if self.lists[l].flags & LIST_SHIFTED == 0 {
+                        self.lists[l].flags |= LIST_SHIFTED;
+                        shift += 1;
+                    }
+                    col = 0;
+                    owed = true;
+                    continue;
+                }
+                if role == ROLE_TAIL && self.lists[l].flags & LIST_SHIFTED != 0 {
+                    shift -= 1;
+                }
+            }
+            if owed && row.kind & LEXICAL != 0 {
+                continue;
+            }
+            if row.kind & STARTS_LINE != 0 || owed {
+                col = self.indent_width(row.depth as u32 + shift, indent);
+                owed = false;
+            }
+            let bytes = self.bytes_of(i);
+            if row.kind & HAS_NEWLINE != 0 {
+                col = self.columns(&bytes[bytes.rfind('\n').map_or(0, |at| at + 1)..]);
+            } else {
+                col += self.columns(bytes);
+            }
+        }
+    }
+
+    /// Whether the item after separator gap `gap` fits on the line at `col`:
+    /// its rows up to the next gap of the same list, and after the last item
+    /// what follows the list up to the next place the line can end.
+    fn item_fits(&self, gap: usize, col: u32) -> bool {
+        let list = self.rows[gap].list;
+        let tail = self.lists[list as usize].tail as usize;
+        let mut used = col;
+        let mut i = gap;
+        while i < self.rows.len() {
+            let row = &self.rows[i];
+            if row.kind & CONDITIONAL != 0 {
+                i += 1;
+                continue;
+            }
+            if i > gap && row.kind & SEAM != 0 && row.list != NO_LIST {
+                let l = row.list as usize;
+                let next_gap = row.list == list && row.fact & ROLE_MASK == ROLE_AFTER;
+                let past = i > tail && self.adjustable(i);
+                let _ = l;
+                if next_gap || past {
+                    return used <= self.limit;
+                }
+            }
+            let bytes = self.bytes_of(i);
+            if row.kind & HAS_NEWLINE != 0 {
+                used += self.columns(&bytes[..bytes.find('\n').unwrap_or(bytes.len())]);
+                return used <= self.limit;
+            }
+            used += self.columns(bytes);
+            if used > self.limit {
+                return false;
+            }
+            i += 1;
+        }
+        used <= self.limit
+    }
+
+    /// Lay the table out and write its text.
+    pub fn finish(mut self, out: &mut (impl fmt::Write + ?Sized), indent: &str) -> Result<LayoutStats, fmt::Error> {
+        match self.rule {
+            Breaking::Group => self.lay_out_group(indent),
+            Breaking::Fill => self.lay_out_fill(indent),
+        }
+        let mut written = 0usize;
+        let mut shift: u32 = 0;
+        let mut owed = false;
+        let mut active = vec![false; self.lists.len()];
+        let mut start = 0usize;
+        for i in 0..self.rows.len() {
+            let row = self.rows[i];
+            let end = row.end as usize;
+            let bytes = &self.text[start..end];
+            start = end;
+            if row.kind & CONDITIONAL != 0 && self.lists[row.list as usize].flags & LIST_BROKEN == 0 {
+                continue;
+            }
+            if row.kind & SEAM != 0 && row.kind & CONDITIONAL == 0 && row.list != NO_LIST {
+                let l = row.list as usize;
+                let role = row.fact & ROLE_MASK;
+                if row.kind & BREAK != 0 {
+                    if self.lists[l].flags & LIST_SHIFTED != 0 && !active[l] && role != ROLE_TAIL {
+                        active[l] = true;
+                        shift += 1;
+                    }
+                    if role == ROLE_TAIL && active[l] {
+                        active[l] = false;
+                        shift -= 1;
+                    }
+                    out.write_str("\n")?;
+                    written += 1;
+                    owed = true;
+                    continue;
+                }
+                if role == ROLE_TAIL && active[l] {
+                    active[l] = false;
+                    shift -= 1;
+                }
+            }
+            if owed && row.kind & LEXICAL != 0 {
+                continue;
+            }
+            if row.kind & STARTS_LINE != 0 || owed {
+                for _ in 0..(row.depth as u32 + shift) {
+                    out.write_str(indent)?;
+                    written += indent.len();
+                }
+                owed = false;
+            }
+            out.write_str(bytes)?;
+            written += bytes.len();
+        }
+        let need = LIST_SEPARATED | LIST_OPENS_AT_BRACKET | LIST_CLOSES_AT_BRACKET;
+        Ok(LayoutStats {
+            text_bytes: self.text.len(),
+            rows: self.rows.len(),
+            seam_rows: self.rows.iter().filter(|r| r.kind & SEAM != 0).count(),
+            lists: self.lists.len(),
+            breakable_lists: self.lists.iter().filter(|l| l.flags & need == need).count(),
+            broken_lists: self.lists.iter().filter(|l| l.flags & LIST_BROKEN != 0).count(),
+            table_bytes: self.text.capacity() + self.rows.capacity() * std::mem::size_of::<Row>() + self.lists.capacity() * std::mem::size_of::<List>(),
+            out_bytes: written,
+        })
+    }
+}
+
+/// PROTOTYPE: what the spacing writer writes to. Text output writes every
+/// call straight through; a table records the calls and lays out at `finish`.
+pub trait Output {
+    /// Whether this output lays lists out after the render, so the writer
+    /// leaves the conditional trailing separator to it.
+    const LAYS_OUT: bool;
+    /// Text, or the bytes of the seam being flushed.
+    fn bytes(&mut self, s: &str, depth: usize) -> fmt::Result;
+    /// The space the writer inserts between two word characters.
+    fn lexical_space(&mut self, depth: usize) -> fmt::Result;
+    /// Indentation owed before the next text.
+    fn owe_indent(&mut self, depth: usize, unit: &str) -> fmt::Result;
+    fn seam_begin(&mut self) -> usize;
+    fn seam_end(&mut self, start: usize, marked: bool, depth: usize);
+    /// A fact about the pending gap.
+    fn note(&mut self, why: u8);
+    fn note_site(&mut self, flags: u8, set: bool);
+    fn list_open(&mut self, separated: bool);
+    fn list_gap(&mut self, role: u8);
+    fn list_close(&mut self);
+    /// What is written until `conditional_end` exists only when the innermost
+    /// open list breaks; the pending gap's note is set aside meanwhile.
+    fn conditional_begin(&mut self) -> GapNote;
+    fn conditional_end(&mut self, gap: GapNote);
+    fn finish(&mut self, indent: &str) -> Result<Option<LayoutStats>, fmt::Error>;
+}
+
+impl<W: fmt::Write + ?Sized> Output for W {
+    const LAYS_OUT: bool = false;
+    #[inline(always)]
+    fn bytes(&mut self, s: &str, _depth: usize) -> fmt::Result {
+        self.write_str(s)
+    }
+    #[inline(always)]
+    fn lexical_space(&mut self, _depth: usize) -> fmt::Result {
+        self.write_str(" ")
+    }
+    #[inline(always)]
