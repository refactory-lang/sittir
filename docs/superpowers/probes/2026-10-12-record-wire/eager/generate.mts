import assert from 'node:assert/strict';
import { readFile, writeFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import { compileGrammar } from '../../../../../packages/codegen/src/compiler/compile.ts';
import { loadGeneratedIdTables } from '../../../../../packages/codegen/src/compiler/generated-metadata.ts';
import { isMultiple, isRequired, isPatternLeaf } from '../../../../../packages/codegen/src/compiler/model/node-map.ts';
import { BLANK_KIND_ID } from '../../../../../packages/codegen/src/compiler/model/site-preferences.ts';
import { grammarPackage } from '../../../../../packages/codegen/src/grammars.ts';
import {
  nodeRecordLayout,
  nodeSlotShapeOf,
  rustNodeStructName
} from '../../../../../packages/codegen/src/emitters/render-module.ts';
import { slotStoredIds } from '../../../../../packages/codegen/src/emitters/factories.ts';
import {
  collectCatalogKinds,
  collectKindEntries
} from '../../../../../packages/codegen/src/emitters/kind-discriminant.ts';
import { rustFieldIdent } from '../../../../../packages/codegen/src/emitters/node-common.ts';
import { records } from '../../../../../packages/rust/src/records.ts';
import { unitKindIds } from '../../../../../packages/codegen/src/emitters/wrap.ts';
import { INLINE_HEADER_WORDS, type RecordPlace } from '../../../../../packages/codegen/src/emitters/record-layout.ts';
import { format } from './grammar-format.mjs';

const compiled = await compileGrammar({
  package: grammarPackage('rust'),
  generatedIdTables: await loadGeneratedIdTables('rust')
});
const { nodeMap, generatedIdTables } = compiled;
const entries = collectKindEntries(collectCatalogKinds(generatedIdTables), nodeMap, generatedIdTables);
const layouts = new Map(Object.entries(records));
assert.equal(format.inlineHeaderWords, INLINE_HEADER_WORDS);
const wordsByKind = new Map<number, number>();
for (const node of nodeMap.nodes.values()) {
  const kind = node.kindEntry?.id;
  const layout = nodeRecordLayout(node, nodeMap);
  if (kind !== undefined && layout !== undefined && !wordsByKind.has(kind)) wordsByKind.set(kind, layout.words);
}
const output = [
  '// Generated by generate.mts. Regenerate; do not edit.',
  "import { check, ownerOf } from './runtime.mjs';",
  ''
];
const factories: string[] = [];
const views: string[] = [];
const seen = new Set<number>();
const covered: string[] = [];
const skipped: { kind: string; reason: string }[] = [];
const units = new Set([...unitKindIds(nodeMap), BLANK_KIND_ID]);
const leaves = new Set(
  [...nodeMap.nodes.values()].filter(isPatternLeaf).flatMap((node) => (node.kindId === undefined ? [] : [node.kindId]))
);

interface Field {
  input: string;
  key: string;
  local: string;
  getter: string;
  checked: string;
  fallback: string;
  place: RecordPlace;
  shape: string;
  many: boolean;
  units: boolean;
  leaves: boolean;
  nodes: boolean;
  inlineKinds: readonly { kind: number; words: number }[];
}

function objectValue(field: Field, value: string): string {
  if (field.shape === 'presence') return `(${value} ?? false)`;
  if (field.shape === 'text' || (!field.leaves && !field.nodes)) return field.many ? `${value}.slice()` : value;
  const item = (name: string) => (field.units ? `(typeof ${name} === 'number' ? ${name} : ${name}._r)` : `${name}._r`);
  return field.many
    ? `${value}.map((item) => ${item('item')})`
    : `(${value} === undefined ? undefined : ${item(value)})`;
}

function cellStores(field: Field, data: string, at: string, value: string): string {
  const set = (offset: number, expression: string | number) =>
    `${data}[${at}${offset === 0 ? '' : ` + ${offset}`}] = ${expression};`;
  if (field.shape === 'text')
    return `if (${value} !== undefined) { const text = store.intern(${value}); ${set(0, format.builtLeaf)} ${set(2, 'text.offset')} ${set(3, 'text.len')} }`;
  const arms: { test: string | undefined; body: string }[] = [];
  if (field.units)
    arms.push({
      test: field.leaves || field.nodes ? `typeof ${value} === 'number'` : undefined,
      body: `${set(0, format.unit)} ${set(1, value)}`
    });
  if (field.leaves)
    arms.push({
      test: field.nodes ? `${value}._offset !== undefined` : undefined,
      body: `${set(0, format.builtLeaf)} ${set(1, `${value}.$type`)} ${set(2, `${value}._offset`)} ${set(3, `${value}._len`)} ${set(4, `${value}._r`)}`
    });
  if (field.nodes)
    arms.push({
      test: undefined,
      body:
        field.inlineKinds.length === 0
          ? `${set(0, format.child)} ${set(1, `${value}.$type`)} ${set(2, `${value}._r`)}`
          : `const child = store.location(${value}._r); ${set(0, format.inline)} switch (${value}.$type) {
            ${field.inlineKinds.map(({ kind, words }) => `case ${kind}: ${data}.set(child.data.subarray(child.word, child.word + ${words}), ${at} + ${format.inlineHeaderWords}); break;`).join('\n')}
            default: throw new Error('inline child has no stamped record width');
          }`
    });
  if (arms.length === 0) throw new Error('cell has no admitted value form');
  return `if (${value} !== undefined) { ${arms.map(({ test, body }, index) => `${index === 0 ? '' : 'else '}${test === undefined ? '' : `if (${test}) `}{ ${body} }`).join(' ')} }`;
}

function prepareRun(field: Field, value: string): string {
  const { place } = field;
  if (!('run' in place) || place.run === undefined) return '';
  return `const ${field.local}run = arena ? store.run(${value}.length, ${place.run}) : undefined;
    if (arena) { for (let i = 0; i < ${value}.length; i++) {
      const item = ${value}[i]; const data = ${field.local}run.data; const at = ${field.local}run.word + i * ${place.run};
      ${cellStores(field, 'data', 'at', 'item')}
    } }`;
}

function recordStores(field: Field, cursor: string, value: string, clear: boolean): string {
  const { place } = field;
  const at = `${cursor}.word + ${place.word}`;
  const data = `${cursor}.data`;
  if ('bit' in place) {
    const mask = 2 ** place.bit;
    return `${data}[${at}] = (${data}[${at}] & ~${mask}) | (${value} ? ${mask} : 0);`;
  }
  if (place.run !== undefined)
    return `${data}[${at}] = ${field.local}run.at; ${data}[${at} + 1] = ${field.local}run.len;`;
  return `${clear ? `${data}.fill(0, ${at}, ${at} + ${place.width});` : ''} ${cellStores(field, data, at, value)}`;
}

for (const node of nodeMap.nodes.values()) {
  const kind = node.kindEntry?.id;
  if (kind === undefined || seen.has(kind)) continue;
  const layout = nodeRecordLayout(node, nodeMap);
  const leaf = isPatternLeaf(node);
  if (layout === undefined && !leaf) continue;
  const places = new Map(layout?.places.map((place) => [place.field, place]));
  if (node.slots.some((slot) => !places.has(rustFieldIdent(slot.storageName)))) {
    skipped.push({ kind: node.kind, reason: 'public slot has no direct native record cell' });
    continue;
  }
  if (layout !== undefined)
    assert.deepEqual(
      layouts.get(rustNodeStructName(node)),
      { words: layout.words, ...Object.fromEntries(layout.places.map(({ field, ...place }) => [field, place])) },
      node.kind
    );
  seen.add(kind);
  covered.push(node.kind);
  const name = `node${kind}`;
  const build = `build${kind}`;
  factories.push(`${JSON.stringify(node.kind)}: (input) => ${build}(store, input)`);
  views.push(`case ${kind}: return ${name}(store, ref);`);
  if (leaf) {
    output.push(`function ${build}(store, text) { return ${name}(store, store.leaf(${kind}, text)); }`);
    output.push(
      `function ${name}(store, ref) { const address = store.address(ref); return store.register({ $type: ${kind}, _r: address, _offset: ref.offset, _len: ref.len, _text: store.text(ref), text() { return this._text; }, render() { return ownerOf(this).renderRef(this); }, $with: store.register({ _r: address, text(value) { return ${build}(ownerOf(this), value); } }, false) }); }`,
      ''
    );
    continue;
  }
  if (layout === undefined) throw new Error('compound has no layout');
  const fields: Field[] = node.slots.map((slot, index) => {
    const place = places.get(rustFieldIdent(slot.storageName));
    if (place === undefined) throw new Error(`${node.kind}.${slot.storageName}`);
    const many = isMultiple(slot);
    const shape = nodeSlotShapeOf(slot, nodeMap).tag;
    const admitted = slotStoredIds(slot, nodeMap, entries);
    const admittedName = `ids${kind}_${index}`;
    output.push(`const ${admittedName} = ${JSON.stringify(admitted)};`);
    const word = place.word;
    const bit = 'bit' in place ? String(place.bit) : 'undefined';
    const run = 'run' in place ? String(place.run) : 'undefined';
    const inline = 'inline' in place ? (place.inline ?? 0) : 0;
    const getter = `${JSON.stringify(slot.storageKey)}, ${word}, ${run}, ${bit}, ${inline}`;
    const checked = `check(store, value, ${admittedName}, ${JSON.stringify(shape)}, ${isRequired(slot) && shape !== 'presence'}, ${many});`;
    const fallback = many ? '[]' : shape === 'presence' ? 'false' : 'undefined';
    return {
      input: JSON.stringify(slot.storageName),
      key: JSON.stringify(slot.storageKey),
      local: `v${index}`,
      getter,
      checked,
      fallback,
      place,
      shape,
      many,
      units: admitted.some((id) => units.has(id)),
      leaves: admitted.some((id) => leaves.has(id)),
      nodes: admitted.some((id) => !units.has(id) && !leaves.has(id)),
      inlineKinds:
        inline === 0
          ? []
          : admitted
              .filter((id) => !units.has(id) && !leaves.has(id))
              .map((kind) => {
                const words = wordsByKind.get(kind);
                if (words === undefined || words > inline)
                  throw new Error(`${node.kind}.${slot.storageName}: inline kind ${kind} has no fitting record`);
                return { kind, words };
              })
    };
  });
  output.push(`function ${build}(store, input = {}) {`, 'let value;');
  for (const field of fields) {
    output.push(`value = input[${field.input}] ?? ${field.fallback}; ${field.checked}`);
    output.push(`const ${field.local} = value;`);
  }
  output.push('const arena = store.isArena;');
  for (const field of fields) output.push(prepareRun(field, field.local));
  output.push(`const ref = store.begin(${kind}, ${layout.words});`);
  output.push('if (arena) {');
  for (const field of fields) output.push(recordStores(field, 'ref', field.local, false));
  output.push('} else {');
  for (const field of fields) output.push(`ref.data[${field.key}] = ${objectValue(field, field.local)};`);
  output.push('}');
  output.push(`return ${name}(store, ref);`, '}');
  output.push(
    `function ${name}(store, ref) {`,
    'const address = store.address(ref);',
    'return store.register({',
    `$type: ${kind},`,
    '_r: address,',
    'render() { return ownerOf(this).renderRef(this); },'
  );
  for (const field of fields) output.push(`${field.input}() { return ownerOf(this).get(this, ${field.getter}); },`);
  output.push('$with: store.register({ _r: address,');
  for (const field of fields)
    output.push(
      `${field.input}(value) { const store = ownerOf(this); ${field.checked} const arena = store.isArena;
        ${prepareRun(field, 'value')}
        const next = store.copy(this, ${layout.words});
        if (arena) { ${recordStores(field, 'next', 'value', true)} }
        else { next.data[${field.key}] = ${objectValue(field, 'value')}; }
        return ${name}(store, next); },`
    );
  output.push('}, false)', '});', '}', '');
}

assert(covered.includes('function_item'));
assert(covered.includes('parameters'));
assert(covered.includes('block'));
output.push(
  `export function wrap(store, ref) { switch (ref.kind) { ${views.join('\n')} default: throw new Error('no generated view for kind ' + ref.kind); } }`
);
output.push(`export function builders(store) { return { ${factories.join(',\n')} }; }`);
const formatted = spawnSync(
  'pnpm',
  [
    'exec',
    'oxfmt',
    '--ignore-path',
    '/dev/null',
    '--stdin-filepath',
    fileURLToPath(new URL('builders.mjs', import.meta.url))
  ],
  { input: output.join('\n') + '\n', encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 }
);
if (formatted.status !== 0) throw new Error(formatted.stderr);
const source = formatted.stdout;
const manifest =
  JSON.stringify(
    { grammar: 'rust', generatedSha256: createHash('sha256').update(source).digest('hex'), covered, skipped },
    null,
    2
  ) + '\n';
for (const [name, value] of [
  ['builders.mjs', source],
  ['manifest.json', manifest]
]) {
  const path = fileURLToPath(new URL(name, import.meta.url));
  if (process.argv.includes('--check')) assert.equal(await readFile(path, 'utf8'), value, `${name} is stale`);
  else await writeFile(path, value);
}
console.log(
  JSON.stringify({ builders: covered.length, skipped: skipped.length, checked: process.argv.includes('--check') })
);
