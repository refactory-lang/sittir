#!/usr/bin/env bash
# A new worktree or clone checks out from the null commit: install its
# dependencies and build every grammar's native binding, so the checkout can
# run the suite and commit (the pre-commit gate loads the bindings) at once.
# Branch switches pass a real commit and are left alone, as is a checkout
# of a branch that predates the bootstrap script.
# SITTIR_NO_BOOTSTRAP=1 skips it, e.g. for a throwaway detached checkout.
set -euo pipefail
[[ "${1:-}" =~ ^0+$ ]] || exit 0
[ "${SITTIR_NO_BOOTSTRAP:-}" = 1 ] && exit 0
node -e "process.exit(require('./package.json').scripts?.bootstrap ? 0 : 1)" 2>/dev/null || exit 0
echo "post-checkout: bootstrapping $(pwd) (SITTIR_NO_BOOTSTRAP=1 skips)" >&2
exec pnpm run bootstrap
