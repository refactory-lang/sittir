{
	"name": "sittir-python",
	"private": true,
	"description": "Grammar-local Rust / napi-rs engine for @sittir/python.",
	"keywords": [
		"n-api",
		"napi",
		"native",
		"python",
		"sittir",
		"tree-sitter"
	],
	"homepage": "https://github.com/refactory-lang/sittir#readme",
	"license": "MIT",
	"author": "Pradeep Mouli",
	"repository": {
		"type": "git",
		"url": "https://github.com/refactory-lang/sittir.git",
		"directory": "rust/crates/sittir-python"
	},
	"scripts": {
		"build": "tsx ../../../scripts/build-native.mts python --release",
		"build:debug": "tsx ../../../scripts/build-native.mts python",
		"build:gate": "tsx ../../../scripts/build-native.mts python --profile gate"
	},
	"devDependencies": {
		"@napi-rs/cli": "catalog:"
	},
	"engines": {
		"node": ">=24.12.0"
	}
}
