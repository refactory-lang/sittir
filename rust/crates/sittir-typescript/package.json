	"description": "Grammar-local Rust / napi-rs engine for @sittir/typescript.",
	"keywords": [
		"n-api",
		"napi",
		"native",
		"sittir",
		"tree-sitter",
		"typescript"
	],
	"homepage": "https://github.com/refactory-lang/sittir#readme",
	"license": "MIT",
	"author": "Pradeep Mouli",
	"repository": {
