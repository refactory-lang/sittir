{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"paths": {
			"@sittir/types": ["./packages/types/src/index.ts"],
			"@sittir/common": ["./packages/common/src/index.ts"],
			"@sittir/common/engine": ["./packages/common/src/engine-boundary.ts"],
			"@sittir/common/utils": ["./packages/common/src/utils.ts"],
			"@sittir/codegen": ["./packages/codegen/src/index.ts"],
			"@sittir/codegen/run-codegen": ["./packages/codegen/src/run-codegen.ts"],
			"@sittir/codegen/grammars": ["./packages/codegen/src/grammars.ts"],
			"@sittir/codegen/validate/from": ["./packages/codegen/src/validate/from.ts"],
			"@sittir/codegen/validate/factory-render-parse": ["./packages/codegen/src/validate/factory-render-parse.ts"],
			"@sittir/codegen/validate/read-render-parse": ["./packages/codegen/src/validate/read-render-parse.ts"],
			"@sittir/codegen/validate/template-coverage": ["./packages/codegen/src/validate/template-coverage.ts"],
			"@sittir/tools": ["./packages/tools/src/index.ts"],
			"@sittir/tools/post-generate": ["./packages/tools/src/post-generate.ts"],
			"@sittir/cli": ["./packages/cli/src/cli.ts"],
			"@sittir/*/utils": ["./packages/*/src/utils.ts"],
			"@sittir/*": ["./packages/*/src/index.ts"]
		},
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"allowJs": false,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": false,
		"verbatimModuleSyntax": true,
		"noEmit": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": true,
		"declarationMap": true,
		"incremental": false
	},
	"files": [],
	"references": [
		{ "path": "./packages/types/tsconfig.build.json" },
		{ "path": "./packages/common/tsconfig.build.json" },
		{ "path": "./packages/codegen/tsconfig.build.json" },
		{ "path": "./packages/rust/tsconfig.build.json" },
		{ "path": "./packages/typescript/tsconfig.build.json" },
		{ "path": "./packages/python/tsconfig.build.json" },
		{ "path": "./packages/tools/tsconfig.build.json" },
		{ "path": "./packages/cli/tsconfig.build.json" }
	]
}
