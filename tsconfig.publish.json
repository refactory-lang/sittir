{
	// What every package's dist compiles to: syntax the oldest Node the
	// engines fields name can run (es2024 lowers `using`), with the types
	// of the esnext default library the source is checked against.
	"compilerOptions": {
		"target": "es2024",
		"lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "webworker.importscripts", "scripthost"]
	}
}
