	readonly variable_declarator_plain: '=' | 'after' | 'before';
	readonly 'variable_declarator_plain/=': 'after' | 'before';
	readonly while_statement: 'after' | 'before' | 'while';
	readonly 'while_statement/while': 'after' | 'before';
	readonly with_statement: 'after' | 'before' | 'with';
