{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
		"paths": {}
	},
	"references": [
		{ "path": "../types/tsconfig.build.json" },
		{ "path": "../common/tsconfig.build.json" }
	],
	"include": ["src"],
	"exclude": ["node_modules", "dist", "tests", "src/__tests__", "**/__tests__", "**/*.test.ts", "src/emitters/*-ir.ts", "src/emitters/overlays/portable/emit", "src/bindings/pinned-reader.child.ts", "src/bindings/pinned-reader.ts", "src/bindings/pinned-vocabulary.ts", "src/bindings/pinned-typescript.ts"]
}
