{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"isolatedDeclarations": true,
		"rootDir": "./src",
		"outDir": "./build",
		"tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
	},
	"include": ["src"],
	"exclude": ["node_modules", "build", "dist"]
}
