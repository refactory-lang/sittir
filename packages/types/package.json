{
	"name": "@sittir/types",
	"version": "0.1.0",
	"description": "Language-agnostic type projection from tree-sitter grammars to typed IR builders",
	"keywords": [
		"codegen",
		"ir",
		"tree-sitter",
		"types",
		"typescript"
	],
	"homepage": "https://github.com/refactory-lang/sittir#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/refactory-lang/sittir.git",
		"directory": "packages/types"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsrs -p tsconfig.build.json && tsdown",
		"clean": "rm -rf build dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
		"dev": "tsrs -p tsconfig.build.json --watch",
		"type-check": "tsrs --noEmit"
	},
	"devDependencies": {
		"tsdown": "0.23.0",
		"typescript": "7.1.0-beta",
		"type-fest": "^5.6.0"
	}
}
