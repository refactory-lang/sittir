{
	"name": "@sittir/regex",
	"version": "0.1.0",
	"description": "Typed Regex IR builder — node kinds from the tree-sitter-regex grammar",
	"keywords": [
		"ast",
		"codegen",
		"ir",
		"regex",
		"tree-sitter"
	],
	"homepage": "https://github.com/refactory-lang/sittir#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/refactory-lang/sittir.git",
		"directory": "packages/regex"
	},
	"files": [
		"dist",
		"native/index.cjs",
		"native/index.d.ts"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./api": {
			"types": "./dist/api.d.ts",
			"import": "./dist/api.js"
		}
	},
	"scripts": {
		"build": "tsrs --build tsconfig.build.json",
		"clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
		"dev": "tsrs --build tsconfig.build.json --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsrs --noEmit",
		"type-check:grammar": "tsrs -p tsconfig.grammar-sittir.json"
	},
	"dependencies": {
		"@sittir/types": "workspace:*",
		"@sittir/common": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"tree-sitter-regex": "^0.25.0"
	},
	"engines": {
		"node": "^22.14.0 || >=23.6.0"
	},
	"//native": "Native artifacts are grammar-local implementation details for @sittir/regex, built from rust/crates/sittir-regex: native/ holds the loader and its typings, and each platform's binary ships in its own sittir-regex-<platform> package with the engine and std it links.",
	"sittir": {
		"stable": true
	}
}
